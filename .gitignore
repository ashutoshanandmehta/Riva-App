# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.swiftpm/
.build/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Claude Code governance — transient state and per-user overrides only.
# The kit itself (.claude/, vault/, CLAUDE.md) IS tracked.
.claude/state/
.claude/settings.local.json
# MCP servers are per-developer: the Supabase entry carries a production
# project_ref and database scope, so committing it would hand every
# collaborator's agent a live production tool by default.
.mcp.json

# Secrets — never commit API keys or provisioning secrets
*.pem
*.p12
.env

# Local metadata for the Riva-Snap deploy mirror of the backend
backend/.git-snap/

# Nutrition5k eval artifacts (downloaded / generated, not source)
backend/eval/n5k_cache/
backend/eval/images/n5k_*.png
backend/eval/golden.n5k.jsonl
backend/eval/reports/

# Volumetric + real-world eval artifacts (downloaded / generated, not source)
backend/eval/volumetric/depth/
backend/eval/volumetric/rgb/
backend/eval/volumetric/reports/
backend/eval/volumetric/samples_n5k/*.png
backend/eval/realworld/reports/
backend/eval/realworld/dataset/**/capture.mp4

# Supabase CLI link state. Per-developer, and `pooler-url` carries a production
# connection string — never committable.
supabase/.temp/
backend/supabase/.temp/
